# Public base URL of this instance
URL=http://localhost:3000
# Signs sessions and encrypts small stored secrets. Generate with: openssl rand -hex 32
SECRET_KEY=
# Required. Encrypts CA private keys (32 bytes, hex or base64). Generate with: openssl rand -hex 32
# It must differ from SECRET_KEY, and it must be backed up separately and offline: a
# database backup cannot be used without it. The server refuses to start without it.
CERTIFLY_MASTER_KEY=
# Or read it from a file instead, e.g. a Docker secret (set only one of the two):
# CERTIFLY_MASTER_KEY_FILE=/run/secrets/certifly_master_key
# When rotating, put the old key(s) here (comma separated) next to the new CERTIFLY_MASTER_KEY.
# A daily job re-wraps every CA key under the new one; remove the old key afterwards.
CERTIFLY_MASTER_KEY_PREVIOUS=
DATABASE_URL=postgres://certifly:certifly@localhost:5432/certifly

# Set to true behind a reverse proxy that sets X-Forwarded-For/-Host. Without it, rate
# limits count every request as coming from the proxy; never enable it without a proxy.
TRUST_PROXY=false
# Header in which that proxy passes the client certificate for EST re-enrollment (needs TRUST_PROXY=true).
# EST_CLIENT_CERT_HEADER=x-forwarded-tls-client-cert
# Re-enrollment also needs a secret (32+ characters, e.g. openssl rand -hex 32) that the proxy adds to every request in the header below, so the certificate header cannot be forged.
# EST_PROXY_SECRET=
# EST_PROXY_SECRET_HEADER=x-certifly-proxy-secret

# Services this process runs (comma separated): web,worker,cron
SERVICES=web,worker,cron

# One-time token that the first sign-in must present (open /setup?token=<value>). Set it
# whenever the instance is reachable before you have signed in. Ignored once a user exists.
# Without SMTP_URL it is how the first admin is created (then asked to add a passkey).
# Remove it once setup is done.
SETUP_TOKEN=

# Base URL of the public PKI endpoints (CRL, issuer certificates). Defaults to URL.
PKI_BASE_URL=

# Port certifly connects to when it validates ACME http-01 challenges. Default 80.
# ACME_HTTP01_PORT=80
# Port certifly connects to when it validates ACME tls-alpn-01 challenges. Default 443.
# ACME_TLSALPN01_PORT=443

# Email, as an SMTP URL. Examples: smtps://user:password@smtp.example.com:465 (TLS) or
# smtp://user:password@smtp.example.com:587 (STARTTLS). URL-encode special characters in the password.
# With the dev stack (docker/compose.dev.yml), use smtp://localhost:1025 and read the mails
# in Mailpit at http://localhost:8025
SMTP_URL=
SMTP_FROM=certifly <no-reply@example.com>

# OpenID Connect sign-in (optional). Register <URL>/auth/oidc/callback as the redirect URI.
# People who sign in this way get the viewer role unless an admin changes it.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPES=openid profile email
# Name of the ID token claim with the person's groups, e.g. groups. Add the scope your provider needs for it to OIDC_SCOPES.
OIDC_GROUPS_CLAIM=
